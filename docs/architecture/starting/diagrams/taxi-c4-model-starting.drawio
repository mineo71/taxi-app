  <diagram name="C3 — Components" id="c3-components-starting">
    <mxGraphModel dx="1600" dy="1000" grid="0" page="1" pageScale="1" pageWidth="2400" pageHeight="1400" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="page-bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;locked=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2370" height="1360" as="geometry"/></mxCell><mxCell id="v1" value="&lt;b&gt;Level C3 — Component diagram (starting)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Container “Backend API” of the taxi ordering system" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1000" height="80" as="geometry"/></mxCell><mxCell id="clients" value="&lt;b&gt;Passenger app, driver app, admin panel&lt;/b&gt;&lt;br&gt;[Containers: Flutter, React]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="805" y="160" width="460" height="100" as="geometry"/></mxCell><mxCell id="v2" value="Backend API&amp;nbsp;&amp;nbsp;[Container: Node.js, TypeScript, NestJS]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8C8C8C;dashed=1;dashPattern=8 6;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontColor=#6B6B6B;" vertex="1" parent="1"><mxGeometry x="80" y="320" width="1910" height="750" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;API layer&lt;/b&gt;&lt;br&gt;[Component: NestJS controllers, Socket.IO gateway]&lt;br&gt;&lt;br&gt;REST endpoints and WebSocket. Validates input, checks the token and rate limits, returns the stored result for a repeated idempotency key. No business logic" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0A0A0A;fontSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="120" y="380" width="1830" height="110" as="geometry"/></mxCell><mxCell id="auth" value="&lt;b&gt;Auth module&lt;/b&gt;&lt;br&gt;[Component: TypeScript]&lt;br&gt;&lt;br&gt;Login codes, Google / Apple sign-in, tokens" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0A0A0A;fontSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="120" y="590" width="230" height="140" as="geometry"/></mxCell><mxCell id="admin" value="&lt;b&gt;Admin module&lt;/b&gt;&lt;br&gt;[Component: TypeScript]&lt;br&gt;&lt;br&gt;Moderation, tariffs, analytics" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0A0A0A;fontSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="440" y="590" width="230" height="140" as="geometry"/></mxCell><mxCell id="payments" value="&lt;b&gt;Payments module&lt;/b&gt;&lt;br&gt;[Component: TypeScript]&lt;br&gt;&lt;br&gt;Charges with the trip ID as idempotency key, deduplicated webhooks, refunds" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0A0A0A;fontSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="760" y="590" width="230" height="140" as="geometry"/></mxCell><mxCell id="trips" value="&lt;b&gt;Trips module&lt;/b&gt;&lt;br&gt;[Component: TypeScript]&lt;br&gt;&lt;br&gt;Trip state machine, pricing, cancellations. Saves state and outbox event in one transaction" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0A0A0A;fontSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="1080" y="590" width="230" height="140" as="geometry"/></mxCell><mxCell id="matching" value="&lt;b&gt;Matching module&lt;/b&gt;&lt;br&gt;[Component: TypeScript]&lt;br&gt;&lt;br&gt;Nearest drivers, offers with a 15 s timeout" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0A0A0A;fontSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="1400" y="590" width="230" height="140" as="geometry"/></mxCell><mxCell id="data" value="&lt;b&gt;Data access&lt;/b&gt;&lt;br&gt;[Component: Prisma]&lt;br&gt;&lt;br&gt;The only code that knows SQL. Writes outbox events and idempotency keys in the same transaction as the business change" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0A0A0A;fontSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="120" y="860" width="550" height="110" as="geometry"/></mxCell><mxCell id="mapsClient" value="&lt;b&gt;Maps client&lt;/b&gt;&lt;br&gt;[Component: HTTP client]&lt;br&gt;&lt;br&gt;Distance, duration, ETA. Route cache, straight-line fallback" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0A0A0A;fontSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="1080" y="860" width="230" height="110" as="geometry"/></mxCell><mxCell id="redisAdapter" value="&lt;b&gt;Redis adapter&lt;/b&gt;&lt;br&gt;[Component: ioredis, BullMQ]&lt;br&gt;&lt;br&gt;Geo index, TTL keys, pub/sub, route cache" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0A0A0A;fontSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="1400" y="860" width="230" height="110" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;Main database&lt;/b&gt;&lt;br&gt;[Container: PostgreSQL]" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;size=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="265" y="1140" width="260" height="110" as="geometry"/></mxCell><mxCell id="pay" value="&lt;b&gt;Payment provider&lt;/b&gt;&lt;br&gt;[External Software System]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="760" y="1140" width="230" height="100" as="geometry"/></mxCell><mxCell id="maps" value="&lt;b&gt;Google Maps API&lt;/b&gt;&lt;br&gt;[External Software System]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="1080" y="1140" width="230" height="100" as="geometry"/></mxCell><mxCell id="redis" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;[Container: Redis]" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;size=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="1400" y="1140" width="230" height="110" as="geometry"/></mxCell><mxCell id="e3" value="API calls, positions, trip updates&lt;br&gt;[HTTPS / JSON, WebSocket]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=blockThin;html=1;strokeColor=#808080;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="clients" target="api"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-26" as="offset"/></mxGeometry></mxCell><mxCell id="e4" value="Login requests" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=blockThin;html=1;strokeColor=#808080;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.0628;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="api" target="auth"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="Admin requests" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=blockThin;html=1;strokeColor=#808080;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.2377;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="api" target="admin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="Payment webhooks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=blockThin;html=1;strokeColor=#808080;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.4126;exitY=1;exitD