ign=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1846" y="322" width="190" height="28" as="geometry"/></mxCell><mxCell id="v24" value="" style="rounded=1;arcSize=20;html=1;fillColor=#999999;strokeColor=#6B6B6B;" vertex="1" parent="1"><mxGeometry x="1800" y="378" width="34" height="26" as="geometry"/></mxCell><mxCell id="v25" value="External system" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1846" y="378" width="190" height="28" as="geometry"/></mxCell><mxCell id="v26" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#8C8C8C;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="1800" y="434" width="34" height="26" as="geometry"/></mxCell><mxCell id="v27" value="System boundary" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1846" y="434" width="190" height="28" as="geometry"/></mxCell></root>
