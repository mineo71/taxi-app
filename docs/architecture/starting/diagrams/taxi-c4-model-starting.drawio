        <mxCell id="t1" value="&lt;b&gt;Level C1 — System Context diagram (starting)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Taxi ordering system" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#1A1A1A;" vertex="1" parent="1">
