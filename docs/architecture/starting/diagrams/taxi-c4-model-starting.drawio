        </mxCell>
        <mxCell id="e3" value="&lt;b&gt;SMS gateway&lt;/b&gt;&lt;br&gt;[External Software System]&lt;br&gt;&lt;br&gt;Sends one-time login codes" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="860" y="880" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="&lt;b&gt;Firebase Cloud Messaging&lt;/b&gt;&lt;br&gt;[External Software System]&lt;br&gt;&lt;br&gt;Delivers notifications to phones" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1">
