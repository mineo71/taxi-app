  <diagram name="Deployment" id="deployment-starting">
    <mxGraphModel dx="1600" dy="1000" grid="0" page="1" pageScale="1" pageWidth="2100" pageHeight="1300" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="page-bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;locked=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2090" height="1270" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Deployment diagram (starting)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Taxi ordering system — production: one EU region, two availability zones" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1200" height="80" as="geometry"/></mxCell><mxCell id="region" value="&lt;b&gt;Cloud provider — EU region&lt;/b&gt;&amp;nbsp;&amp;nbsp;[Deployment node, CON-8]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A5A5A;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="80" y="290" width="1520" height="910" as="geometry"/></mxCell><mxCell id="zoneA" value="&lt;b&gt;Availability zone A&lt;/b&gt;&amp;nbsp;&amp;nbsp;[Deployment node]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F8FC;strokeColor=#8FA9C8;verticalAlign=top;align=right;spacingRight=14;spacingTop=8;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="120" y="470" width="700" height="700" as="geometry"/></mxCell><mxCell id="zoneB" value="&lt;b&gt;Availability zone B&lt;/b&gt;&amp;nbsp;&amp;nbsp;[Deployment node]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F8FC;strokeColor=#8FA9C8;verticalAlign=top;align=right;spacingRight=14;spacingTop=8;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="860" y="470" width="700" height="700" as="geometry"/></mxCell><mxCell id="region2" value="&lt;b&gt;Second EU region&lt;/b&gt;&amp;nbsp;&amp;nbsp;[Deployment node]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A5A5A;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1640" y="560" width="400" height="270" as="geometry"/></mxCell><mxCell id="passengerApp" value="&lt;b&gt;Passenger app&lt;/b&gt;&lt;br&gt;[Container: Flutter]&lt;br&gt;on the passenger's phone" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="420" y="150" width="300" height="90" as="geometry"/></mxCell><mxCell id="driverApp" value="&lt;b&gt;Driver app&lt;/b&gt;&lt;br&gt;[Container: Flutter, SQLite]&lt;br&gt;on the driver's phone" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="820" y="150" width="300" height="90" as="geometry"/></mxCell><mxCell id="adminApp" value="&lt;b&gt;Admin panel&lt;/b&gt;&lt;br&gt;[Container: React]&lt;br&gt;in the operator's browser" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="1220" y="150" width="300" height="90" as="geometry"/></mxCell><mxCell id="monitor" value="&lt;b&gt;Synthetic monitoring&lt;/b&gt;&lt;br&gt;[External Software System]&lt;br&gt;&lt;br&gt;Places a test order every minute from two regions" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="1660" y="340" width="380" height="100" as="geometry"/></mxCell><mxCell id="lb" value="&lt;b&gt;Managed load balancer&lt;/b&gt;&amp;nbsp;&amp;nbsp;[Infrastructure node, spans both zones]&lt;br&gt;Single entry point api.&amp;lt;domain&amp;gt;. TLS, health check every 10 s, traffic only to healthy instances" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A1A1A;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="150" y="350" width="1380" height="80" as="geometry"/></mxCell><mxCell id="api1" value="&lt;b&gt;Backend API — instance 1&lt;/b&gt;&lt;br&gt;[Container: Node.js, NestJS]&lt;br&gt;&lt;br&gt;REST API and WebSocket" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="150" y="520" width="300" height="110" as="geometry"/></mxCell><mxCell id="wrk1" value="&lt;b&gt;Background worker — instance 1&lt;/b&gt;&lt;br&gt;[Container: Node.js, BullMQ]&lt;br&gt;&lt;br&gt;Outbox relay and jobs" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="490" y="520" width="300" height="110" as="geometry"/></mxCell><mxCell id="api2" value="&lt;b&gt;Backend API — instance 2&lt;/b&gt;&lt;br&gt;[Container: Node.js, NestJS]&lt;br&gt;&lt;br&gt;REST API and WebSocket" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="890" y="520" width="300" height="110" as="geometry"/></mxCell><mxCell id="wrk2" value="&lt;b&gt;Background worker — instance 2&lt;/b&gt;&lt;br&gt;[Container: Node.js, BullMQ]&lt;br&gt;&lt;br&gt;Outbox relay and jobs" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="1230" y="520" width="300" height="110" as="geometry"/></mxCell><mxCell id="endpoints" value="Managed endpoints &lt;b&gt;postgres-primary&lt;/b&gt; and &lt;b&gt;redis-primary&lt;/b&gt;: on failover they move to the standby and the replica in the other zone" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A1A1A;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="150" y="690" width="1380" height="44" as="geometry"/></mxCell><mxCell id="redisP" value="&lt;b&gt;Redis — primary&lt;/b&gt;&lt;br&gt;[Managed Redis]&lt;br&gt;&lt;br&gt;Geo index, queue, pub/sub, cache. Append-only persistence" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;size=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="150" y="790" width="300" height="150" as="geometry"/></mxCell><mxCell id="pgP" value="&lt;b&gt;PostgreSQL — primary&lt;/b&gt;&lt;br&gt;[Managed PostgreSQL]&lt;br&gt;&lt;br&gt;Source of truth, outbox. Point-in-time recovery" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;size=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="490" y="790" width="300" height="150" as="geometry"/></mxCell><mxCell id="pgS" value="&lt;b&gt;PostgreSQL — standby&lt;/b&gt;&lt;br&gt;[Managed PostgreSQL]&lt;br&gt;&lt;br&gt;Synchronous copy, promoted automatically" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;size=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="890" y="790" width="300" height="150" as="geometry"/></mxCell><mxCell id="redisR" value="&lt;b&gt;Redis — replica&lt;/b&gt;&lt;br&gt;[Managed Redis]&lt;br&gt;&lt;br&gt;Promoted automatically" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;size=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="1230" y="790" width="300" height="150" as="geometry"/></mxCell><mxCell id="backup" value="&lt;b&gt;Backup storage&lt;/b&gt;&lt;br&gt;[Object storage]&lt;br&gt;&lt;br&gt;Daily snapshots and transaction log, 30 days" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFF