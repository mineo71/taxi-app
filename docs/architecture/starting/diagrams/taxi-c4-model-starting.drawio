  <diagram name="C2 — Containers" id="c2-containers-starting">
    <mxGraphModel dx="1600" dy="1000" grid="0" page="1" pageScale="1" pageWidth="2100" pageHeight="1250" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="page-bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;locked=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2090" height="1180" as="geometry"/></mxCell><mxCell id="v1" value="&lt;b&gt;Level C2 — Container diagram (starting)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Taxi ordering system — MVP: modular monolith in TypeScript" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1000" height="80" as="geometry"/></mxCell><mxCell id="passenger" value="&lt;b&gt;Passenger&lt;/b&gt;&lt;br&gt;[Person]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="160" width="300" height="100" as="geometry"/></mxCell><mxCell id="driver" value="&lt;b&gt;Driver&lt;/b&gt;&lt;br&gt;[Person]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="520" y="160" width="300" height="100" as="geometry"/></mxCell><mxCell id="operator" value="&lt;b&gt;Support operator&lt;/b&gt;&lt;br&gt;[Person]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="920" y="160" width="300" height="100" as="geometry"/></mxCell><mxCell id="v2" value="Taxi ordering system&amp;nbsp;&amp;nbsp;[Software System]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8C8C8C;dashed=1;dashPattern=8 6;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontColor=#6B6B6B;" vertex="1" parent="1"><mxGeometry x="80" y="320" width="1220" height="800" as="geometry"/></mxCell><mxCell id="passengerApp" value="&lt;b&gt;Passenger app&lt;/b&gt;&lt;br&gt;[Container: Flutter]&lt;br&gt;&lt;br&gt;Ride ordering, map, payment, rating" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="380" width="300" height="130" as="geometry"/></mxCell><mxCell id="driverApp" value="&lt;b&gt;Driver app&lt;/b&gt;&lt;br&gt;[Container: Flutter, SQLite]&lt;br&gt;&lt;br&gt;Accepting orders, navigation, earnings. Offline action queue in a local SQLite database" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="520" y="380" width="300" height="130" as="geometry"/></mxCell><mxCell id="adminApp" value="&lt;b&gt;Admin panel&lt;/b&gt;&lt;br&gt;[Container: React, TypeScript]&lt;br&gt;&lt;br&gt;Driver moderation, tariffs, analytics" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="920" y="380" width="300" height="130" as="geometry"/></mxCell><mxCell id="backend" value="&lt;b&gt;Backend API&lt;/b&gt;&lt;br&gt;[Container: Node.js, TypeScript, NestJS]&lt;br&gt;&lt;br&gt;Modular monolith: auth, trips and pricing, matching, location, payments, admin. REST API and WebSocket, idempotency keys. 2 instances, one per availability zone" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="620" width="1100" height="130" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;Main database&lt;/b&gt;&lt;br&gt;[Container: PostgreSQL]&lt;br&gt;&lt;br&gt;Users, drivers, trips, tariffs, payments, outbox, idempotency keys. Primary + synchronous standby" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;size=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="120" y="860" width="300" height="150" as="geometry"/></mxCell><mxCell id="redis" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;[Container: Redis]&lt;br&gt;&lt;br&gt;Driver geo index, live positions, route cache, login codes, job queue, WebSocket pub/sub. Primary + replica" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;size=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="520" y="860" width="300" height="150" as="geometry"/></mxCell><mxCell id="worker" value="&lt;b&gt;Background worker&lt;/b&gt;&lt;br&gt;[Container: Node.js, TypeScript, BullMQ]&lt;br&gt;&lt;br&gt;Same codebase as the backend, 2 instances. Relays the outbox: card charges, receipts, notifications, retries" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="920" y="860" width="300" height="150" as="geometry"/></mxCell><mxCell id="maps" value="&lt;b&gt;Google Maps API&lt;/b&gt;&lt;br&gt;[External Software System]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="1400" y="380" width="300" height="100" as="geometry"/></mxCell><mxCell id="pay" value="&lt;b&gt;Payment provider&lt;/b&gt;&lt;br&gt;[External Software System]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="1400" y="620" width="300" height="100" as="geometry"/></mxCell><mxCell id="sms" value="&lt;b&gt;SMS gateway&lt;/b&gt;&lt;br&gt;[External Software System]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="1400" y="860" width="300" height="100" as="geometry"/></mxCell><mxCell id="push" value="&lt;b&gt;Firebase Cloud Messaging&lt;/b&gt;&lt;br&gt;[External Software System]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="1400" y="1040" width="300" height="100" as="geometry"/></mxCell><mxCell id="e3" value="Orders a ride" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=blockThin;html=1;strokeColor=#808080;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="passenger" target="passengerApp"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-24" as="offset"/></mxGeometry></mxCell><mxCell id="e4" value="Accepts orders" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=blockThin;html=1;strokeColor=#808080;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="driver" target="driverApp"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-24" as="offset"/></mxGeometry></mxCell><mxCell id="e5" value="Manages the system" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=blockThin;html=1;strokeColor=#808080;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="operator" target="adminApp"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-24" as="offset"/></mxGeometry></mxCell><mxCell id="e6" value="Calls API, receives car position&lt;br&gt;[HTTPS / JSON, WebSocket]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=blockThin;html=1;strokeColor=#808080;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.136;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="passengerApp" target="backend"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="Calls API, sends location,&lt;br&gt;replays offline actions&lt;br&gt;[HTTPS / JSON, WebSocket]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=blockThin;html=1;strokeColor=#808080;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="driverApp" target="backend"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="Calls API&lt;br&gt;[HTTPS / JSON]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=blockThin;html=1;strokeColor=#808080;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.864;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="adminApp" target="backend"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="Reads and writes data&lt;br&gt;[SQL / TCP]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=blockThin;html=1;strokeColor=#808080;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.136;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="backend" target="db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="Geo index, live positions,&lt;br&gt;codes, route cache&lt;br&gt;[Redis protocol]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=blockThin;html=1;strokeColor=#808080;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="backend" target="redis"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="Takes jobs&lt;br&gt;[Redis protocol]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=blockThin;html=1;strokeColor=#808080;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="worker" target="redis"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="Reads the outbox, saves results&lt;br&gt;[SQL / TCP]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=blockThin;html=1;strokeColor=#808080;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="worker" target="db"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1070" y="1075"/><mxPoint x="270" y="1075"/></Array></mxGeometry></mxCell><mxCell id="e13" value="Requests route and ETA&lt;br&gt;[HTTPS / REST]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=blockThin;html=1;strokeColor=#808080;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="backend" target="maps"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="Creates payments,&lt;br&gt;receives webhooks&lt;br&gt;[HTTPS / REST]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=blockThin;html=1;strokeColor=#808080;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="backend" target="pay"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="Sends login codes&lt;br&gt;[HTTPS / REST]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=blockThin;html=1;strokeColor=#808080;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3