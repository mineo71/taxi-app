        <mxCell id="t1" value="&lt;b&gt;Level C1 — System Context diagram (starting)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Taxi ordering system" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="800" height="80" as="geometry" />
        </mxCell>

        <mxCell id="p1" value="&lt;b&gt;Passenger&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Orders a ride, pays for it and rates the driver" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="200" y="180" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;Driver&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Accepts orders and completes trips" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="180" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;Support operator&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Moderates drivers, configures tariffs, handles complaints" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1040" y="180" width="300" height="120" as="geometry" />
        </mxCell>

        <mxCell id="sys" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;Taxi ordering system&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;Connects passengers and drivers: takes orders, finds the nearest car, runs the trip and calculates the price" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;fontSize=13;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="500" width="1180" height="170" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="&lt;b&gt;Google Maps API&lt;/b&gt;&lt;br&gt;[External Software System]&lt;br&gt;&lt;br&gt;Builds routes and calculates pickup ETA" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="880" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="&lt;b&gt;Payment provider&lt;/b&gt;&lt;br&gt;[External Software System]&lt;br&gt;&lt;br&gt;Charges the passenger’s card" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1">
