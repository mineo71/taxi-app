br&gt;&lt;br&gt;Ride ordering, map, payment, rating" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="380" width="300" height="130" as="geometry"/></mxCell><mxCell id="driverApp" value="&lt;b&gt;Driver app&lt;/b&gt;&lt;br&gt;[Container: Flutter]&lt;br&gt;&lt;br&gt;Accepting orders, navigation, earnings" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="520" y="380" width="300" height="130" as="geometry"/></mxCell><mxCell id="adminApp" value="&lt;b&gt;Admin panel&lt;/b&gt;&lt;br&gt;[Container: React, TypeScript]&lt;br&gt;&lt;br&gt;Driver moderation, tariffs, analytics" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="920" y="380" width="300" height="130" as="geometry"/></mxCell><mxCell id="backend" value="&lt;b&gt;Backend API&lt;/b&gt;&lt;br&gt;[Container: Node.js, TypeScript, NestJS]&lt;br&gt;&lt;br&gt;Modular monolith: auth, trips and pricing, matching, payments, admin. REST API and WebSocket. 2 instances" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="620" width="1100" height="130" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;Main database&lt;/b&gt;&lt;br&gt;[Container: PostgreSQL]&lt;br&gt;&lt;br&gt;Users, drivers, trips, tariffs, payments" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;size=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="120" y="860" width="300" height="130" as="geometry"/></mxCell><mxCell id="redis" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;[Container: Redis]&lt;br&gt;&lt;br&gt;Driver geo index, login codes, job queue, WebSocket pub/sub" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;size=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="520" y="860" width="300" height="130" as="geometry"/></mxCell><mxCell id="worker" value="&lt;b&gt;Background worker&lt;/b&gt;&lt;br&gt;[Container: Node.js, TypeScript, BullMQ]&lt;br&gt;&lt;br&gt;Same codebase as the backend. Notifications, receipts, payment retries" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="920" y="860" width="300" height="130" as="geometry"/></mxCell><mxCell id="maps" value="&lt;b&gt;Google Maps API&lt;/b&gt;&lt;br&gt;[External Software System]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="1400" y="380" width="300" height="100" as="geometry"/></mxCell><mxCell id="pay" value="&lt;b&gt;Payment provider&lt;/b&gt;&lt;br&gt;[External Software System]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="1400" y="620" width="300" height="100" as="geometry"/></mxCell><mxCell id="sms" value="&lt;b&gt;SMS gateway&lt;/b&gt;&lt;br&gt;[External Software System]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="1400" y="860" width="300" height="100" as="geometry"/></mxCell><mxCell id="push" value="&lt;b&gt;Firebase Cloud Messaging&lt;/b&gt;&lt;br&gt;[External Software System]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;spacing=8;" v