        <mxCell id="bnd3" value="Сервіс замовлень&amp;nbsp;&amp;nbsp;[Container: Node.js]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8C8C8C;dashed=1;dashPattern=8 6;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontColor=#6B6B6B;" vertex="1" parent="1">
          <mxGeometry x="60" y="380" width="1460" height="760" as="geometry" />
        </mxCell>

        <mxCell id="m1" value="&lt;b&gt;Контролер замовлень&lt;/b&gt;&lt;br&gt;[Component: Express, REST]&lt;br&gt;&lt;br&gt;Приймає запити на створення, зміну та скасування поїздки і перевіряє вхідні дані" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0A0A0A;fontSize=12;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="430" width="1020" height="120" as="geometry" />
        </mxCell>

        <mxCell id="m4" value="&lt;b&gt;Обробник скасувань&lt;/b&gt;&lt;br&gt;[Component: TypeScript]&lt;br&gt;&lt;br&gt;Визначає, чи нараховувати штраф за скасування" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0A0A0A;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="680" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="&lt;b&gt;Менеджер життєвого циклу поїздки&lt;/b&gt;&lt;br&gt;[Component: TypeScript]&lt;br&gt;&lt;br&gt;Керує станами: створено, водія знайдено, в дорозі, завершено" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0A0A0A;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="460" y="680" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="&lt;b&gt;Калькулятор вартості&lt;/b&gt;&lt;br&gt;[Component: TypeScript]&lt;br&gt;&lt;br&gt;Рахує ціну з урахуванням тарифу, відстані та простою" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0A0A0A;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="820" y="680" width="300" height="130" as="geometry" />
