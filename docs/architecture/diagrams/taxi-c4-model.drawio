        <mxCell id="r2" value="Приймає замовлення,&lt;br&gt;передає геопозицію&lt;br&gt;[HTTPS / WebSocket]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=blockThin;html=1;strokeColor=#808080;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="Керує тарифами&lt;br&gt;і водіями&lt;br&gt;[HTTPS / JSON]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=blockThin;html=1;strokeColor=#808080;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.856;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="sys">
