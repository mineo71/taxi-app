        <mxCell id="d1" value="&lt;b&gt;Основна база даних&lt;/b&gt;&lt;br&gt;[Container: PostgreSQL]&lt;br&gt;&lt;br&gt;Користувачі, поїздки, тарифи" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;size=16;spacing=6;" vertex="1" parent="1">
