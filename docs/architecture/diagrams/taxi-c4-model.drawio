        <mxCell id="c1" value="&lt;b&gt;Застосунок пасажира&lt;/b&gt;&lt;br&gt;[Container: Flutter]&lt;br&gt;&lt;br&gt;Замовлення поїздки, карта, оплата, оцінка" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1">
