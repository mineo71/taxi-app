        <mxCell id="g1" value="&lt;b&gt;Шлюз інтерфейсу програмування (API Gateway)&lt;/b&gt;&lt;br&gt;[Container: Node.js]&lt;br&gt;&lt;br&gt;Єдина точка входу для застосунків пасажира, водія та адміністратора" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="280" y="180" width="660" height="110" as="geometry" />
