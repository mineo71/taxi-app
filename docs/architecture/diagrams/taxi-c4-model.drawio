        </mxCell>

        <mxCell id="c5" value="&lt;b&gt;Шлюз інтерфейсу програмування (API Gateway)&lt;/b&gt;&lt;br&gt;[Container: Node.js]&lt;br&gt;&lt;br&gt;Єдина точка входу: автентифікація, перевірка прав, маршрутизація запитів" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;spacing=10;" vertex="1" parent="1">
