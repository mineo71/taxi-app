  <diagram name="C1 — System Context" id="c1-context">
    <mxGraphModel dx="1600" dy="1000" grid="0" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t1" value="&lt;b&gt;Рівень C1 — System Context diagram&lt;/b&gt;&lt;br&gt;&lt;br&gt;Система замовлення таксі" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="800" height="80" as="geometry" />
        </mxCell>

        <mxCell id="p1" value="&lt;b&gt;Пасажир&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Замовляє поїздку, оплачує її та оцінює водія" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="200" y="180" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;Водій&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Приймає замовлення і виконує поїздки" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="180" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;Оператор підтримки&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Модерує водіїв, налаштовує тарифи, обробляє скарги" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1040" y="180" width="300" height="120" as="geometry" />
        </mxCell>

        <mxCell id="sys" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;Система замовлення таксі&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;Зʼєднує пасажирів і водіїв: приймає замовлення, підбирає найближче авто, веде поїздку та розраховує вартість" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;fontSize=13;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="500" width="1180" height="170" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="&lt;b&gt;Картографічний сервіс&lt;/b&gt;&lt;br&gt;[External Software System]&lt;br&gt;&lt;br&gt;Будує маршрут і розраховує час подачі" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="880" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="&lt;b&gt;Платіжний шлюз&lt;/b&gt;&lt;br&gt;[External Software System]&lt;br&gt;&lt;br&gt;Списує кошти з картки пасажира" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="520" y="880" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="&lt;b&gt;Шлюз коротких повідомлень&lt;/b&gt;&lt;br&gt;[External Software System]&lt;br&gt;&lt;br&gt;Надсилає одноразовий код для входу" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="860" y="880" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="&lt;b&gt;Сервіс сповіщень&lt;/b&gt;&lt;br&gt;[External Software System]&lt;br&gt;&lt;br&gt;Доставляє сповіщення на телефон" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1200" y="880" width="280" height="120" as="geometry" />
        </mxCell>

        <mxCell id="r1" value="Замовляє поїздку,&lt;br&gt;оплачує, оцінює&lt;br&gt;[HTTPS / JSON]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=blockThin;html=1;strokeColor=#808080;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.144;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="sys">
