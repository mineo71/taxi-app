        <mxCell id="m5" value="&lt;b&gt;Репозиторій поїздок&lt;/b&gt;&lt;br&gt;[Component: Prisma]&lt;br&gt;&lt;br&gt;Читає і записує дані поїздок у базу" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0A0A0A;fontSize=12;spacing=8;" vertex="1" parent="1">
