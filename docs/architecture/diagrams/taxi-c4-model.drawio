        </mxCell>
        <mxCell id="c9" value="&lt;b&gt;Сервіс сповіщень&lt;/b&gt;&lt;br&gt;[Container: Node.js]&lt;br&gt;&lt;br&gt;Сповіщення на телефон і коди підтвердження" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1">
